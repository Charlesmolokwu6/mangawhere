# Copy to deploy/vps/.env and fill in. Every variable from render.yaml
# works here too (see README.md); only SITE_DOMAIN is required.

# The domain pointing at this server, without https://. Caddy gets its
# certificate for this name.
SITE_DOMAIN=mangawhere.to
# Same domain with https://; switches on the title pages and sitemap.
PUBLIC_SITE_URL=https://mangawhere.to

VAPID_CONTACT_EMAIL=
POLL_INTERVAL_SECONDS=1800

# Optional: keep the database off this machine too (README.md, Turso).
# Left empty, it lives in the app-data volume; back that up.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

TURNSTILE_SECRET_KEY=
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
YOUTUBE_COOKIES=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# 1 on a machine with 4GB+ of memory.
NARRATION_ENABLED=0
HEAVY_SLOTS=1
