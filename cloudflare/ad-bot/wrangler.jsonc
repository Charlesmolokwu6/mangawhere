// Deploy with:  cd cloudflare/ad-bot && npx wrangler deploy
// (or paste ad-bot-worker.js into a new Worker in the Cloudflare dashboard).
// See README.md in this folder for the full, step-by-step setup.
{
  "name": "mangawhere-adbot",
  "main": "ad-bot-worker.js",
  "compatibility_date": "2026-09-01",

  // The KV namespace that holds the on/off state. Create it with
  //   npx wrangler kv namespace create AD_KV
  // then paste the id it prints here (dashboard: Workers & Pages > KV).
  "kv_namespaces": [
    { "binding": "AD_KV", "id": "PUT_YOUR_KV_NAMESPACE_ID_HERE" }
  ],

  // Your numeric Telegram id (from @userinfobot). Not a secret.
  "vars": { "ADMIN_ID": "PUT_YOUR_TELEGRAM_NUMERIC_ID_HERE" }

  // BOT_TOKEN and WEBHOOK_SECRET are secrets, NOT vars — set them with:
  //   npx wrangler secret put BOT_TOKEN
  //   npx wrangler secret put WEBHOOK_SECRET
  // (or dashboard: the Worker > Settings > Variables and Secrets).
}
